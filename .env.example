# ApexTrader environment template
# Copy to .env and replace blank credential values before running.
# Never commit .env or put live credentials in this file.

# ── Trading mode, brokers, and credentials ────────────────────────────────
TRADE_MODE=paper
STOCKS_BROKER=alpaca
ALPACA_DATA_FEED=iex
PRICE_DATA_SOURCE=alpaca
USE_FINNHUB_HISTORICAL=false
PAPER_ALPACA_API_KEY=
PAPER_ALPACA_API_SECRET=
LIVE_ALPACA_API_KEY=
LIVE_ALPACA_API_SECRET=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_ACCOUNT_ID=
ETRADE_SANDBOX=false
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_ACCOUNT_NUMBER=
SCHWAB_USE_SANDBOX=false
FINNHUB_API_KEY=
SEEKING_ALPHA_API_KEY=
SEEKING_ALPHA_HOST=seeking-alpha.p.rapidapi.com
YAHOO_FINANCE15_API_KEY=

# ── Equity execution, risk, and live probe mode ───────────────────────────
MAX_POSITIONS=1
SMALL_ACCOUNT_MAX_POSITIONS=1
POSITION_SIZE_PCT=95.0
MARGIN_LEVERAGE=4.0
MIN_POSITION_DOLLARS=5
MIN_BUYING_POWER_PCT=5.0
SMALL_ACCOUNT_EQUITY_THRESHOLD=5000
PDT_ACCOUNT_MIN=0
PDT_OPTIONS_DAY_TRADE_RESERVE=1
PDT_WARN_AT_REMAINING=1
LONG_ONLY_MODE=false
MIN_SIGNAL_CONFIDENCE=0.82
MIN_SHORT_CONFIDENCE_BEAR=0.82
MAX_SIGNALS_PER_CYCLE=1
LIVE_PROBE_MODE=true
LIVE_PROBE_SHARES=1
LIVE_PROBE_MAX_ENTRIES_PER_DAY=10
LIVE_PROBE_SCALE_IN_ENABLED=true
LIVE_PROBE_SCALE_IN_MINUTES=30
LIVE_PROBE_SCALE_IN_MIN_GAIN_PCT=0.5
LIVE_PROBE_SCALE_IN_BUYING_POWER_PCT=25.0
LIVE_PROBE_SCALE_IN_CUTOFF_TIME=15:15

# ── Equity profit, trailing stop, and ATR time-loss exits ─────────────────
TAKE_PROFIT_EXTREME=25.0
TAKE_PROFIT_HIGH=25.0
TAKE_PROFIT_MEDIUM=20.0
TAKE_PROFIT_NORMAL=15.0
TAKE_PROFIT_PCT=25.0
SCALEOUT_TRAIL_PCT=5.0
PROTECT_POSITIONS_ENABLED=false
TP_INTERMEDIATE_PCT=6.0
TP_INTERMEDIATE_TRAIL_PCT=4.0
TP_FINAL_PCT=20.0
DEAD_MONEY_MINUTES=45
DEAD_MONEY_MAX_ADVERSE_DRIFT_PCT=1.0
TIME_LOSS_ATR_MULTIPLIER=0.35
TIME_LOSS_ATR_MIN_PCT=1.0
TIME_LOSS_ATR_MAX_PCT=2.5

# ── Scan scheduling, market hours, and EOD ─────────────────────────────────
ADAPTIVE_INTERVALS=false
SCAN_INTERVAL_MIN=3
FORCE_SCAN=false
FORCE_EQUITY=false
FORCE_CRYPTO=false
EOD_CLOSE_ALL=true
EOD_CLOSE_TIME=15:55

# ── Equity scanning, discovery, and filters ─────────────────────────────────
MIN_STOCK_PRICE=10
MAX_GAP_CHASE_PCT=8.0
TI_MAX_GAP_CHASE_PCT=7.0
TI_RVOL_MIN=1.5
TI_MIN_DOLLAR_VOLUME=1500000
MIDDAY_CHOP_START=11:30
MIDDAY_CHOP_END=13:00
MIDDAY_MIN_CONFIDENCE=0.88
USE_SENTIMENT_GATE=false
USE_TRADEIDEAS_DISCOVERY=true
TRADEIDEAS_CHROME_PROFILE=
TRADEIDEAS_BROWSER=edge
TI_PRIMARY_TTL_MINUTES=15
UNIVERSE_TTL_TIER1=15
UNIVERSE_TTL_TIER2=15
UNIVERSE_TTL_TIER3=15
SECTOR_SYMPATHY_INTERVAL_MIN=15
USE_EDGAR_SCANNER=true
EDGAR_SCANNER_INTERVAL_MIN=10
USE_PREOPEN_INTELLIGENCE=true
PREOPEN_INTELLIGENCE_SCAN_INTERVAL_MIN=15
PREOPEN_INTELLIGENCE_MAX_TICKERS=20
PREOPEN_USE_REGIME_GATING=true
PREOPEN_USE_SENTIMENT_GATING=true

