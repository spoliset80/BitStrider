OPTIONS_IV_RANK_SPREAD_THRESHOLD=60
OPTIONS_EARNINGS_AVOID_DAYS=15
OPTIONS_TRAIL_ACTIVATE_PCT=15.0
OPTIONS_TRAIL_DRAWDOWN_PCT=10.0
OPTIONS_CHAIN_CACHE_MAX=300
SPREAD_PROFIT_TARGET_LOWER=50.0
SPREAD_PROFIT_TARGET_UPPER=75.0
SPREAD_UNDERLYING_SL_PCTFROM_LONG=1.0
SPREAD_DTE_EXIT_THRESHOLD=7

# ── Crypto ──────────────────────────────────────────────────────────────────
CRYPTO_ENABLED=false
CRYPTO_MAX_POSITIONS=12
CRYPTO_POSITION_PCT=0.0
CRYPTO_MIN_NOTIONAL=100.0
