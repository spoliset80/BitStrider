OPTIONS_THETA_EXIT_DTE=4
OPTIONS_COVERED_CALL_DELTA=0.25
OPTIONS_MIN_SIGNAL_CONFIDENCE=0.80
OPTIONS_MIN_SIGNAL_CONFIDENCE_TI=0.65
OPTIONS_MIN_STOCK_PRICE=8.0
OPTIONS_MIN_MOVE_PCT=1.5
OPTIONS_MIN_MOVE_PCT_TI=0.8
OPTIONS_MIN_RVOL=1.5
